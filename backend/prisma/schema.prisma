generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              Int           @id @default(autoincrement())
  email           String        @unique
  username        String? // unique username for all users
  password        String
  fullName        String
  phoneNumber     String?
  // Business details (optional, mainly for owners)
  businessName    String?
  businessType    String? // 'Individual Owner' or 'Company'
  panVatNumber    String?
  address         String?
  city            String?
  province        String?
  // ... rest of the fields remain unchanged
  role            Role          @default(PLAYER)
  isApproved      Boolean       @default(false)
  createdAt       DateTime      @default(now())
  isActive        Boolean       @default(true)
  isEmailVerified Boolean       @default(false)
  otp             String?
  otpExpiry       DateTime?
  ownerBlocks     Block[]       @relation("OwnerBlocks")
  playerBlocks    Block[]       @relation("PlayerBlocks")
  bookings        Booking[]
  favorites       Favorite[]
  ownedFutsals    Futsal[]      @relation("OwnerFutsals")
  reviews         Review[]
  teams           TeamMember[]
  activities      ActivityLog[]
}

model Futsal {
  id             Int          @id @default(autoincrement())
  name           String
  description    String?
  address        String
  latitude       Float?
  longitude      Float?
  images         String[]
  ownerId        Int
  isApproved     Boolean      @default(false)
  createdAt      DateTime     @default(now())
  operatingHours Json?
  status         FutsalStatus @default(PENDING)
  blocks         Block[]
  courts         Court[]
  favorites      Favorite[]
  owner          User         @relation("OwnerFutsals", fields: [ownerId], references: [id])
  reviews        Review[]
  tournaments    Tournament[]
}

model Court {
  id                 Int        @id @default(autoincrement())
  futsalId           Int
  courtNumber        String
  courtType          String
  basePrice          Float
  peakPrice          Float?
  amenities          String[]
  isActive           Boolean    @default(true)
  isUnderMaintenance Boolean    @default(false)
  maintenanceUntil   DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  futsal             Futsal     @relation(fields: [futsalId], references: [id])
  slots              TimeSlot[]
}

model TimeSlot {
  id          Int        @id @default(autoincrement())
  courtId     Int
  date        DateTime
  startTime   String
  endTime     String
  price       Float
  status      SlotStatus @default(AVAILABLE)
  lockedUntil DateTime?
  bookings    Booking[]
  court       Court      @relation(fields: [courtId], references: [id])
}

model Booking {
  id            Int           @id @default(autoincrement())
  userId        Int
  slotId        Int
  totalPrice    Float
  status        BookingStatus @default(PENDING)
  bookingDate   DateTime      @default(now())
  checkInTime   DateTime?
  checkOutTime  DateTime?
  duration      Int           @default(1)
  groupId       String?
  paymentMethod String        @default("COD")
  slot          TimeSlot      @relation(fields: [slotId], references: [id])
  user          User          @relation(fields: [userId], references: [id])
  payment       Payment?
  review        Review?

  @@index([slotId])
  @@index([status])
  @@index([groupId])
}

model Payment {
  id            Int      @id @default(autoincrement())
  bookingId     Int      @unique
  amount        Float
  method        String
  status        String
  transactionId String?
  createdAt     DateTime @default(now())
  booking       Booking  @relation(fields: [bookingId], references: [id])
}

model Tournament {
  id          Int            @id @default(autoincrement())
  futsalId    Int
  name        String
  type        TournamentType
  startDate   DateTime
  endDate     DateTime?
  maxTeams    Int
  status      String         @default("DRAFT")
  createdAt   DateTime       @default(now())
  description String?
  entryFee    Float?
  isPublished Boolean        @default(false)
  prizePool   Float?
  prizes      String[]
  rules       String?
  matches     Match[]
  teams       Team[]
  futsal      Futsal         @relation(fields: [futsalId], references: [id])
}

model Team {
  id           Int          @id @default(autoincrement())
  name         String
  tournamentId Int
  logo         String?
  awayMatches  Match[]      @relation("AwayTeam")
  homeMatches  Match[]      @relation("HomeTeam")
  tournament   Tournament   @relation(fields: [tournamentId], references: [id])
  players      TeamMember[]
}

model TeamMember {
  id          Int     @id @default(autoincrement())
  teamId      Int
  userId      Int?
  role        String  @default("PLAYER")
  jerseyColor String?
  playerName  String?
  playerPhone String?
  team        Team    @relation(fields: [teamId], references: [id])
  user        User?   @relation(fields: [userId], references: [id])
}

model Match {
  id           Int         @id @default(autoincrement())
  tournamentId Int
  homeTeamId   Int
  awayTeamId   Int
  matchDate    DateTime
  homeScore    Int?
  awayScore    Int?
  status       MatchStatus @default(SCHEDULED)
  round        String
  awayTeam     Team        @relation("AwayTeam", fields: [awayTeamId], references: [id])
  homeTeam     Team        @relation("HomeTeam", fields: [homeTeamId], references: [id])
  tournament   Tournament  @relation(fields: [tournamentId], references: [id])
}

model Review {
  id        Int      @id @default(autoincrement())
  userId    Int
  futsalId  Int
  rating    Float
  comment   String?
  createdAt DateTime @default(now())
  bookingId Int      @unique
  reply     String?
  updatedAt DateTime @updatedAt
  booking   Booking  @relation(fields: [bookingId], references: [id])
  futsal    Futsal   @relation(fields: [futsalId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@index([futsalId])
  @@index([userId])
}

model Block {
  id        Int      @id @default(autoincrement())
  ownerId   Int
  playerId  Int
  futsalId  Int
  reason    String?
  createdAt DateTime @default(now())
  futsal    Futsal   @relation(fields: [futsalId], references: [id])
  owner     User     @relation("OwnerBlocks", fields: [ownerId], references: [id])
  player    User     @relation("PlayerBlocks", fields: [playerId], references: [id])

  @@unique([ownerId, playerId, futsalId])
}

model Favorite {
  id        Int      @id @default(autoincrement())
  userId    Int
  futsalId  Int
  createdAt DateTime @default(now())
  futsal    Futsal   @relation(fields: [futsalId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, futsalId])
}

model SystemSettings {
  id                       Int      @id @default(autoincrement())
  autoApproveOwners        Boolean  @default(false)
  autoApproveFutsals       Boolean  @default(false)
  maintenanceMode          Boolean  @default(false)
  bookingCancellationHours Int      @default(2)
  slotLockMinutes          Int      @default(5)
  slotGenerationDays       Int      @default(30)
  updatedAt                DateTime @updatedAt
}

model Ad {
  id         Int      @id @default(autoincrement())
  title      String
  subtitle   String
  buttonText String
  buttonLink String
  imageUrl   String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

enum Role {
  PLAYER
  OWNER
  ADMIN
}

enum SlotStatus {
  AVAILABLE
  LOCKED
  BOOKED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum TournamentType {
  LEAGUE
  KNOCKOUT
  ROUND_ROBIN
}

enum MatchStatus {
  SCHEDULED
  ONGOING
  COMPLETED
  CANCELLED
}

enum FutsalStatus {
  PENDING
  ACTIVE
  DEACTIVATED
}

model ActivityLog {
  id          Int      @id @default(autoincrement())
  type        String // e.g., 'BOOKING', 'USER_REGISTER'
  description String
  userId      Int?
  user        User?    @relation(fields: [userId], references: [id])
  category    String // e.g., 'Booking', 'User Added'
  status      String // e.g., 'completed', 'pending', 'registered'
  metadata    Json? // extra info (name, email, phone, bookingId, etc.)
  createdAt   DateTime @default(now())
}
